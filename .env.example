# ─── Environment ──────────────────────────────────────────
# TEST_ENV: STG, EA, EAR, REL, EPH, DEV
TEST_ENV=STG
# ENTERPRISE: enterprise name used for data file lookup
ENTERPRISE=LegionCoffee
# FILE_NUMBER: optional suffix for data files (leave empty for default)
FILE_NUMBER=
# IS_LOCAL: set to 'true' for local environment
IS_LOCAL=false

# ─── URL Overrides (optional — auto-resolved from TEST_ENV) ──
# BASE_URL=https://staging-enterprise.dev.legion.work/
# API_BASE_URL=https://staging-api.dev.legion.work/

# ─── Test Selection ──────────────────────────────────────
TEAM=all
TYPE=all
# TEST_TAGS=@P1-Critical

# ─── Browser & Execution ────────────────────────────────
HEADED=false
WORKERS=2
RETRY_COUNT=1
TIMEOUT=60000

# ─── Parallel Mode ─────────────────────────────────────
# PARALLEL_MODE: Controls how Playwright parallelizes tests
#   'feature' (default) — Each feature file = 1 worker, scenarios run sequentially within.
#                          Multiple feature files run in parallel across workers.
#   'scenario' — Scenarios can run in parallel across workers (used by split scripts).
PARALLEL_MODE=feature
# FEATURE_PATHS: Comma-separated explicit feature file paths (overrides TEAM/TYPE resolution).
#   Used internally by run-split-scenarios.js. Leave empty for normal runs.
# FEATURE_PATHS=teams/sch/features/ui/overtime.feature
# SHARD_ID: Unique ID for per-shard bddgen output directory isolation.
#   Used internally by sharded/split scripts. Leave empty for normal runs.
# SHARD_ID=

# ─── Auth/Session Reuse ─────────────────────────────────
# AUTH_ROLES: comma-separated roles to pre-authenticate in globalSetup
AUTH_ROLES=Admin
# FRESH_AUTH: set to 'true' to clear stale sessions on fresh run
FRESH_AUTH=false

# ─── Logging ─────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARN, ERROR, FATAL
LOG_LEVEL=INFO
# LOG_TO_FILE: write JSON logs to reports/logs/
LOG_TO_FILE=true

# ─── CI / Slack ──────────────────────────────────────────
# CI=true
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
