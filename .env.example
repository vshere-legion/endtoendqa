# ============================================================
# QA End-to-End Pipeline — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Argo Workflows ---
ARGO_SERVER=https://argo.ops.dev.legion.work
ARGO_TOKEN=Bearer v2:your-token-here
ARGO_NAMESPACE=argo

# --- Jira (Atlassian) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=vshere@legion.co
JIRA_API_TOKEN=your-jira-api-token

# --- Confluence (Atlassian) ---
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USER_EMAIL=vshere@legion.co
CONFLUENCE_API_TOKEN=your-confluence-api-token

# --- Slack ---
SLACK_CHANNEL_ID=C0AQRDEDJ1J
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# --- GitHub ---
GITHUB_TOKEN=ghp_your-github-token
GITHUB_REPO=your-org/your-repo

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-your-key

# --- Datadog ---
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
