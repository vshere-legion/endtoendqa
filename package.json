{
  "name": "playwright-cucumber-enterprise",
  "version": "2.0.0",
  "description": "Enterprise Playwright + Cucumber BDD Framework for Legion",
  "scripts": {
    "bddgen": "bddgen",
    "test": "npm run bddgen && npx playwright test",
    "test:chromium": "npm run bddgen && npx playwright test --project=chromium",
    "test:firefox": "npm run bddgen && npx playwright test --project=firefox",
    "test:webkit": "npm run bddgen && npx playwright test --project=webkit",
    "test:headed": "HEADED=true npm test",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:smoke": "TEST_TAGS='@P1-Critical' npm test",
    "test:parallel": "WORKERS=8 npm test",
    "test:feature-parallel": "PARALLEL_MODE=feature npm test",
    "test:split": "node scripts/run-split-scenarios.js",
    "test:sharded": "node scripts/run-sharded.js",
    "test:sharded:smoke": "node scripts/run-sharded.js --tags @P1-Critical --workers 15",
    "test:sharded:regression": "node scripts/run-sharded.js --tags @Regression --workers 20",
    "test:dry-run": "node scripts/run-sharded.js --dry-run",
    "merge-reports": "node scripts/merge-reports.js",
    "merge-reports:failures": "node scripts/merge-reports.js --capture-failures",
    "rerun-failed": "node scripts/rerun-failed.js",
    "report:open": "npx playwright show-report reports/html",
    "validate": "npm run lint && npm run typecheck && npx bddgen",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "clean": "rimraf '.features-gen*' reports test-results blob-reports .auth .locks",
    "typecheck": "tsc --noEmit",
    "playwright:install": "npx playwright install --with-deps",
    "docker:build": "docker build -t playwright-legion .",
    "docker:test": "docker compose up test-chromium",
    "docker:test:all": "docker compose up test-all",
    "docker:test:smoke": "docker compose up test-smoke",
    "docker:test:team": "docker compose up test-team",
    "docker:sharded": "docker compose --profile sharded up"
  },
  "keywords": ["playwright", "bdd", "cucumber", "testing", "legion"],
  "author": "QA Team",
  "license": "MIT",
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "playwright-bdd": "^6.1.0",
    "@cucumber/cucumber": "^10.0.0",
    "dotenv": "^16.4.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
